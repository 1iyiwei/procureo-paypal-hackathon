# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Any random string (letters, digits, _ and -); only used in webhook mode
TELEGRAM_WEBHOOK_SECRET=

# Sandbox app credentials from developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# CURRENCY=USD

# From platform.openai.com; may also be set in your shell
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra
# Set to false when recording the demo video, to hide notes about simulated stores and /ff
# DEMO_HINTS=true

# Local: http://localhost:8000 (long polling). Render: https://<service>.onrender.com (webhook).
PUBLIC_BASE_URL=http://localhost:8000
# DATABASE_PATH=data/app.db
