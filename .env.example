# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Any random string (letters, digits, _ and -); only used in webhook mode
TELEGRAM_WEBHOOK_SECRET=

# Sandbox app credentials from developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# CURRENCY=USD

# Local: http://localhost:8000 (long polling). Render: https://<service>.onrender.com (webhook).
PUBLIC_BASE_URL=http://localhost:8000
# DATABASE_PATH=data/app.db
