# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Any random string (letters, digits, _ and -); only used in webhook mode
TELEGRAM_WEBHOOK_SECRET=

# Sandbox app credentials from developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# CURRENCY=USD

# From platform.openai.com; may also be set in your shell
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra
# Set to false when recording the demo video, to hide notes about simulated stores and /ff
# DEMO_HINTS=true

# From channel3.ai; enables /live, which watches real products and prices
CHANNEL3_API_KEY=
# LIVE_CHECK_MINUTES=180

# Local: http://localhost:8000 (long polling). On Render, leave it out: the service's https URL is used, in webhook mode.
PUBLIC_BASE_URL=http://localhost:8000
# If set, a chat must send this code once before the bot does anything. Use letters, digits, _ and - only.
# ACCESS_CODE=
# DATABASE_PATH=data/app.db
